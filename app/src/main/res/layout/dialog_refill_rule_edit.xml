<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Source Type Selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/rule_source_type_label"
        android:textStyle="bold"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rule_source_type_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Feed"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <!-- Source Selection (Feed/Tag) -->
    <TextView
        android:id="@+id/rule_source_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/rule_source_label"
        android:textStyle="bold"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rule_source_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text=""
        android:visibility="gone"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <!-- Selection Method -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/rule_selection_method_label"
        android:textStyle="bold"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rule_selection_method_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Oldest First"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <!-- Count -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/rule_count_label"
        android:textStyle="bold"
        android:textSize="14sp" />

    <NumberPicker
        android:id="@+id/rule_count_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />

</LinearLayout>
