<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground">

    <!-- Drag handle icon (only visible for reorderable items) -->
    <ImageView
        android:id="@+id/rule_item_drag_handle"
        android:layout_width="16dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:importantForAccessibility="no"
        android:contentDescription="@string/drag_to_reorder"
        android:scaleType="fitCenter"
        android:paddingStart="0dp"
        android:paddingEnd="4dp"
        app:srcCompat="?attr/dragview_background"
        android:visibility="visible" />

    <!-- Rule icon/indicator -->
    <ImageView
        android:id="@+id/rule_item_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@string/rule_type"
        android:scaleType="fitCenter" />

    <!-- Rule description -->
    <TextView
        android:id="@+id/rule_item_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:textSize="16sp"
        android:textAppearance="?attr/textAppearanceBody1" />

    <!-- Edit button -->
    <ImageView
        android:id="@+id/rule_item_edit_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:padding="8dp"
        android:contentDescription="@string/edit_rule_label"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_edit"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

    <!-- Delete button -->
    <ImageView
        android:id="@+id/rule_item_delete_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:padding="8dp"
        android:contentDescription="@string/delete_rule_label"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_delete"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

</LinearLayout>
